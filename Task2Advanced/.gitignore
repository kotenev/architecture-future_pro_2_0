# =============================================================================
# .gitignore — исключение секретов и локальных файлов Terraform
# =============================================================================

# Terraform state — НИКОГДА не должен быть в репозитории
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plan files (могут содержать секреты)
*.tfplan
tfplan

# Terraform working directories
.terraform/
.terraform.lock.hcl

# Переменные с секретами (используйте terraform.tfvars.example как шаблон)
terraform.tfvars
*.auto.tfvars

# Crash log files
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log