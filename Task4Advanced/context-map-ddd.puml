rectangle "Credit Management\n\n//Управление кредитами//\n---\nЗаявки, скоринг\nДоговоры\n\nTeam: Финтех\n[Golang, Java]" as CM #FFE0B2

rectangle "Payment Processing\n\n//Платёжные операции//\n---\nТранзакции\nЭквайринг\n\nTeam: Финтех\n[Golang, Java]" as PP #FFE0B2

